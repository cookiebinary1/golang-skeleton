# Copy to .env - compose reads it automatically, `make dev` sources it for Air.

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Host port published by the dev Compose stack (raise if 5432 is taken locally)
POSTGRES_HOST_PORT=5432
# Optional full DSN override (takes precedence over the parts above)
# POSTGRES_DSN=postgres://app:app@127.0.0.1:5432/app?sslmode=disable

# NATS
NATS_URL=nats://127.0.0.1:4222

# Services
API_HTTP_ADDR=127.0.0.1:8080
WORKER_HTTP_ADDR=127.0.0.1:8081

# Logging: debug|info|warn|error
LOG_LEVEL=debug
# text|json
LOG_FORMAT=text
ENV=dev

# Web: same-origin Vite proxy target when running on the host
WEB_PORT=3000
API_PROXY_TARGET=http://127.0.0.1:8080
